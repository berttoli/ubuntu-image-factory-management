#cloud-config
autoinstall:
  version: 1
  locale: en_US.UTF-8
  keyboard:
    layout: us
  timezone: UTC
  refresh-installer:
    update: true
  source:
    id: ubuntu-server-minimal
  identity:
    hostname: __HOSTNAME__
    username: factory
    password: '__PASSWORD_HASH__'
  ssh:
    install-server: true
    allow-pw: false
    authorized-keys:
      - '__SSH_PUBLIC_KEY__'
  storage:
    layout:
      name: lvm
      match:
        serial: '__DISK_SERIAL__'
  packages:
    - openssh-server
    - unattended-upgrades
    - ufw
    - apparmor
    - auditd
    - qemu-guest-agent
  codecs:
    install: false
  drivers:
    install: false
  updates: security
  late-commands:
    - curtin in-target --target=/target -- systemctl enable ssh
    - curtin in-target --target=/target -- systemctl enable unattended-upgrades
    - curtin in-target --target=/target -- systemctl enable apparmor
    - curtin in-target --target=/target -- systemctl enable auditd
    - curtin in-target --target=/target -- bash -c 'install -d -m 0755 /etc/ssh/sshd_config.d && printf "%s\n" "PermitRootLogin no" "PasswordAuthentication no" "KbdInteractiveAuthentication no" "PubkeyAuthentication yes" "X11Forwarding no" "MaxAuthTries 3" > /etc/ssh/sshd_config.d/99-factory-hardening.conf'
    - curtin in-target --target=/target -- bash -c 'printf "%s\n" "net.ipv4.conf.all.rp_filter=1" "net.ipv4.conf.default.rp_filter=1" "kernel.kptr_restrict=2" "kernel.dmesg_restrict=1" > /etc/sysctl.d/99-factory-hardening.conf'
  user-data:
    disable_root: true
    ssh_pwauth: false

